# 发布镜像引用，填写 registry.example.com/team/go-service@sha256:<digest> 形式的实际值。
GO_APP_IMAGE=
# Go 服务的宿主机发布地址。0.0.0.0 表示监听宿主机的所有 IPv4 网卡。
# 测试客户端用宿主机实际可达的 IP 或域名和 GO_HTTP_PORT 访问。
# 跨机器访问还需要路由、防火墙和安全组允许这个端口。设为 127.0.0.1 则只对本机发布。
GO_BIND_ADDRESS=0.0.0.0
GO_HTTP_PORT=18081
# 填写 Agent 可访问的测试中心 OTLP HTTP 基础地址，日志和 Span 共用。
GO_LOG_OTLP_ENDPOINT=
# 采集密钥由启动环境传入，使用测试中心 Collector 的 token。
OTLP_AUTH_TOKEN=
