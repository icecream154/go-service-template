# Go 服务的宿主机发布地址。0.0.0.0 表示监听宿主机的所有 IPv4 网卡。
# 本机可用 127.0.0.1 访问，其他设备用宿主机实际 IP 或域名和 GO_HTTP_PORT 访问。
# 跨机器访问还需要路由、防火墙和安全组允许这个端口。设为 127.0.0.1 则只对本机发布。
GO_BIND_ADDRESS=0.0.0.0
GO_HTTP_PORT=8080

# 同一台 Mac 上的 Docker Desktop 示例。跨机器部署填写中心的内网地址或 HTTPS 入口。
# 填写 OTLP HTTP 基础地址。Agent 会按信号追加 /v1/logs 或 /v1/traces。
GO_LOG_OTLP_ENDPOINT=http://host.docker.internal:4318
# 采集密钥由启动环境传入，使用中心 Collector 的同一个 token。
OTLP_AUTH_TOKEN=eac9751ef55dfedea57c64a406472ba5575588ce7551bd4f6ec0677c7316b671
