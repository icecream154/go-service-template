# 相对路径以 deploy/compose.yaml 所在目录为基准。应用的业务配置直接写入此目录下的 YAML。
GO_CONFIG_DIR=./environments/dev/config.local
GO_BIND_ADDRESS=127.0.0.1
GO_HTTP_PORT=8080

# 同一台 Mac 上的 Docker Desktop 示例。跨机器部署填写中心的内网地址或 HTTPS 入口。
# 使用 OTLP HTTP 基础地址，Agent 会自动追加 /v1/logs。
GO_LOG_OTLP_ENDPOINT=http://host.docker.internal:4318
# 采集密钥由启动环境传入，使用中心 Collector 的同一个 token。
OTLP_AUTH_TOKEN=
